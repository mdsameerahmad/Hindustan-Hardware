{
  "name": "hindustan-hardware-backend",
  "version": "1.0.0",
  "description": "Backend foundation and API services for Hindustan Hardware & Sanitary E-Commerce",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "rimraf dist && tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:api": "node scripts/production-smoke.mjs",
    "test:production": "node scripts/production-check.mjs",
    "simulate:delivery": "tsx scripts/simulate-delivery.ts",
    "catalogue:validate": "tsx scripts/catalogue/validate-catalogue.ts",
    "catalogue:seed": "tsx scripts/catalogue/seed-catalogue.ts"
  },
  "keywords": [
    "ecommerce",
    "hardware",
    "express",
    "typescript",
    "supabase"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "@types/multer": "^2.3.0",
    "@types/pg": "^8.23.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.0.0",
    "morgan": "^1.10.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.6.0",
    "pg": "^8.23.1",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "uuid": "^11.1.0",
    "xlsx": "^0.18.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.13.10",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "rimraf": "^6.0.1",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
